# ============================================================
# LexiLoop（词环）环境变量示例
# 复制为 .env.local 后填写。Token 只留在服务端，永不下发前端。
# ============================================================

# ---------- 墨墨开放 API（可选；不填则进入 Demo 模式） ----------
# 获取：墨墨 App → 我的 → 更多设置 → 实验功能 → 开放 API
MAIMEMO_API_TOKEN=

# 强制 Demo 模式（即使填了 Token）。本地演示用，可选。
DEMO_MODE=

# ---------- LLM（可选；不填则生成功能返回预置 Demo 文章） ----------
# 任何 OpenAI 兼容接口都可以。DeepSeek 示例：
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# OpenAI 官方示例：
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# ---------- TTS（可选；不填则使用静音占位音频，节奏仍可练习） ----------
# 优先级：azure > elevenlabs > openai > mock。可用 TTS_PROVIDER 强制指定。
TTS_PROVIDER=

# Azure Speech
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2

# OpenAI TTS（不要复用 DeepSeek 的 Key）
OPENAI_TTS_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ---------- 本地路径（一般不用改） ----------
# LEXILOOP_DATA_DIR=./data
# 阅读器默认音色：female-us / male-us / female-uk / male-uk
DEFAULT_VOICE=female-us
